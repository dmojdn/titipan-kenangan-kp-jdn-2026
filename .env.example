# ==========================================
# KONFIGURASI APLIKASI TITIPAN KENANGAN KP JDN
# ==========================================

# Kunci rahsia Flask untuk sesi dan keselamatan borang
SECRET_KEY=tukar_kepada_kunci_rahsia_panjang_dan_rawak_di_sini

# Mod pembangunan (True / False)
FLASK_DEBUG=True

# Kunci Laluan Dashboard Admin (Contoh: JDN2026!Kenangan)
ADMIN_PASSWORD=admin123

# ==========================================
# INTEGRASI GOOGLE DRIVE OAUTH 2.0
# ==========================================
# Akaun Storan Sasaran: dmojdn@gmail.com
# Root Folder ID rasmi di Google Drive:
GOOGLE_DRIVE_ROOT_FOLDER_ID=1HIEuEkoEoiHHcEuqh-zj7AE-aFzepXUH

# Diperoleh daripada Google Cloud Console (OAuth 2.0 Client IDs - Web Application)
GOOGLE_CLIENT_ID=masukkan_client_id_dari_google_cloud_console.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=masukkan_client_secret_dari_google_cloud_console

# URI Pengalihan Semula (Redirect URI) - Mesti sepadan tepat dengan tetapan di Google Cloud Console
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/admin/oauth/callback

# Lokasi fail token kebenaran OAuth (dijana secara automatik selepas log masuk kebenaran)
GOOGLE_TOKEN_FILE=token.json
